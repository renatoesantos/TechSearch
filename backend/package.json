{
  "name": "techsearch-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "scraper:run": "tsx src/workers/scraper.worker.ts --once",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "test:e2e:auth": "cross-env NODE_ENV=test tsx scripts/auth-e2e.ts",
    "test:e2e:api": "cross-env NODE_ENV=test tsx scripts/api-e2e.ts",
    "test:e2e:alerts": "cross-env NODE_ENV=test tsx scripts/alert-e2e.ts",
    "test:e2e:scraper": "cross-env NODE_ENV=test tsx scripts/scraper-e2e.ts",
    "test:e2e": "npm run test:e2e:auth && npm run test:e2e:api && npm run test:e2e:alerts && npm run test:e2e:scraper"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "puppeteer": "^23.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.16",
    "cross-env": "^10.1.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
