NODE_ENV=development
PORT=3333
TRUST_PROXY=0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techsearch?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=techsearch-api
JWT_AUDIENCE=techsearch-web
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# SMTP (opcional em dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TechSearch <no-reply@techsearch.app>

# Scraper
SCRAPER_ENABLED=true
SCRAPER_CRON=0 0,12 * * *
SCRAPER_TIMEOUT_MS=30000
SCRAPER_CONCURRENCY=2
SCRAPER_USER_AGENT=TechSearchPriceBot/1.0 (+https://techsearch.app/bot-info)
SCRAPER_HEADLESS=true
