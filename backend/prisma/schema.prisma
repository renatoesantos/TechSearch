// ============================================================================
// TechSearch — Rastreamento e histórico de preços de hardware (Brasil)
// Schema Prisma / PostgreSQL
//
// Convenções:
//  - IDs em UUID (não expõem volume de registros e facilitam sharding futuro)
//  - Nomes em camelCase no Prisma, snake_case no banco (@map)
//  - Valores monetários SEMPRE em Decimal(12,2) — nunca Float
//  - Soft delete via deletedAt (LGPD: permite exclusão lógica imediata e
//    purga física em janela posterior)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum NotificationChannel {
  EMAIL
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum ScraperRunStatus {
  RUNNING
  SUCCESS
  PARTIAL // algumas lojas/produtos falharam, mas o ciclo concluiu
  FAILED
}

// ============================================================================
// USUÁRIOS E AUTENTICAÇÃO (LGPD: apenas nome, e-mail e senha com hash)
// ============================================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255) // sempre salvo em lowercase
  passwordHash String   @map("password_hash") @db.VarChar(255) // bcrypt/argon2
  role         UserRole @default(USER)

  /// Atualizado a cada troca de senha. Tokens emitidos antes desta data
  /// são rejeitados pelo middleware de autenticação (invalida sessões).
  passwordChangedAt DateTime? @map("password_changed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // soft delete / "conta excluída"

  wishlists      Wishlist[]
  priceAlerts    PriceAlert[]
  notifications  Notification[]
  passwordResets PasswordResetToken[]

  @@index([deletedAt])
  @@map("users")
}

/// Tokens de recuperação de senha. Guardamos apenas o HASH do token
/// (o token em texto puro só existe no e-mail enviado ao usuário).
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") // ex.: now() + 1h
  usedAt    DateTime? @map("used_at") // null = ainda válido
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================================================================
// CATÁLOGO: CATEGORIAS, PRODUTOS, LOJAS
// ============================================================================

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80) // "Placa-mãe", "Memória RAM"...
  slug        String   @unique @db.VarChar(80) // "placa-mae", "memoria-ram"
  description String?  @db.VarChar(255)
  icon        String?  @db.VarChar(80) // nome do ícone no frontend
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(280)
  brand       String? @db.VarChar(80) // Intel, AMD, ASUS, Kingston...
  model       String? @db.VarChar(120)
  description String? @db.Text
  /// Ficha técnica flexível por categoria (socket, DDR, TDP, clock...).
  /// Ex.: { "socket": "AM5", "memoria": "DDR5", "tdp_w": 120 }
  specs       Json?
  imageUrl    String? @map("image_url") @db.VarChar(1024)

  categoryId String @map("category_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  offers        ProductOffer[]
  priceHistory  PriceHistory[]
  wishlistItems WishlistItem[]
  priceAlerts   PriceAlert[]

  @@index([categoryId])
  @@index([brand])
  @@index([name]) // busca por texto (ILIKE); pg_trgm será habilitado em migration
  @@index([deletedAt])
  @@map("products")
}

model Store {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @unique @db.VarChar(80) // KaBuM!, Pichau, Terabyte...
  slug       String   @unique @db.VarChar(80) // kabum, pichau, terabyte
  websiteUrl String   @map("website_url") @db.VarChar(255)
  logoUrl    String?  @map("logo_url") @db.VarChar(1024)
  /// Chave que liga a loja ao módulo de scraping (ex.: "kabum", "pichau").
  /// Permite desativar/rotacionar um scraper sem mexer no código da loja.
  scraperKey String   @unique @map("scraper_key") @db.VarChar(50)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  offers       ProductOffer[]
  priceHistory PriceHistory[]
  scraperRuns  ScraperRun[]

  @@map("stores")
}

/// Oferta de um produto em uma loja específica (preço "atual" / vitrine).
/// É o registro que o worker atualiza a cada ciclo de scraping.
model ProductOffer {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  storeId   String @map("store_id") @db.Uuid
  url       String @db.VarChar(1024) // URL do anúncio na loja

  /// Preço à vista (Pix/Boleto). NULL quando out_of_stock = true,
  /// para não contaminar médias/gráficos com R$ 0,00.
  currentPrice  Decimal?  @map("current_price") @db.Decimal(12, 2)
  outOfStock    Boolean   @default(false) @map("out_of_stock")
  lastCheckedAt DateTime? @map("last_checked_at")
  /// Última falha de scraping desta oferta (auditoria isolada por loja).
  lastError     String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId]) // 1 oferta por produto por loja
  @@index([storeId])
  @@index([currentPrice])
  @@index([outOfStock])
  @@map("product_offers")
}

/// Histórico de preços DIÁRIO (um registro por produto/loja/dia).
/// O worker roda 2x/dia e faz UPSERT no mesmo dia, guardando o último
/// preço observado do dia — o gráfico fica com 1 ponto por dia.
model PriceHistory {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  storeId   String @map("store_id") @db.Uuid

  /// NULL quando o produto estava sem estoque no dia (out_of_stock = true).
  price      Decimal? @db.Decimal(12, 2)
  outOfStock Boolean  @default(false) @map("out_of_stock")

  /// Data "de calendário" (date, sem hora) — usada na unicidade diária.
  recordedDate DateTime @map("recorded_date") @db.Date
  /// Momento exato da última coleta que atualizou o dia.
  recordedAt   DateTime @default(now()) @map("recorded_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId, recordedDate])
  @@index([productId, recordedAt]) // consulta do gráfico (ordem cronológica)
  @@index([storeId, recordedDate])
  @@map("price_history")
}

/// Log de cada ciclo de scraping por loja — dá visibilidade quando um
/// scraper quebra (regra de ouro: falhas isoladas por loja).
model ScraperRun {
  id         String           @id @default(uuid()) @db.Uuid
  storeId    String           @map("store_id") @db.Uuid
  status     ScraperRunStatus @default(RUNNING)
  startedAt  DateTime         @default(now()) @map("started_at")
  finishedAt DateTime?        @map("finished_at")

  offersProcessed Int     @default(0) @map("offers_processed")
  offersFailed    Int     @default(0) @map("offers_failed")
  errorMessage    String? @map("error_message") @db.Text

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startedAt])
  @@map("scraper_runs")
}

// ============================================================================
// LISTAS DE DESEJOS (montagens) E ALERTAS DE PREÇO
// ============================================================================

model Wishlist {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  name        String  @db.VarChar(120) // "PC Gamer 2026", "Upgrade RAM"...
  description String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String  @id @default(uuid()) @db.Uuid
  wishlistId String  @map("wishlist_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  quantity   Int     @default(1)
  notes      String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wishlist   Wishlist    @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceAlert PriceAlert? // no máx. 1 alerta por item da lista

  @@unique([wishlistId, productId]) // não duplica o mesmo produto na lista
  @@index([productId])
  @@map("wishlist_items")
}

/// Alerta de preço do usuário para um produto.
/// Unicidade (userId, productId) garante o cooldown global de 7 dias
/// "por usuário por produto", independentemente de quantas listas ele tenha.
model PriceAlert {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  productId String @map("product_id") @db.Uuid

  /// Vínculo opcional ao item da lista de desejos (1:1).
  wishlistItemId String? @unique @map("wishlist_item_id") @db.Uuid

  targetPrice Decimal @map("target_price") @db.Decimal(12, 2) // "preço desejado"
  isActive    Boolean @default(true) @map("is_active")

  /// Controle de cooldown: último aviso disparado para este usuário/produto.
  lastNotifiedAt    DateTime? @map("last_notified_at")
  /// Preço que disparou o último aviso (mostra "caiu de X para Y").
  lastNotifiedPrice Decimal?  @map("last_notified_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItem  WishlistItem?  @relation(fields: [wishlistItemId], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([userId, productId])
  @@index([productId, isActive]) // varredura do worker: "quem quer este produto?"
  @@index([userId])
  @@map("price_alerts")
}

/// Registro de cada notificação enviada (auditoria + idempotência).
model Notification {
  id           String @id @default(uuid()) @db.Uuid
  userId       String @map("user_id") @db.Uuid
  priceAlertId String @map("price_alert_id") @db.Uuid

  channel NotificationChannel @default(EMAIL)
  status  NotificationStatus  @default(PENDING)

  priceAtNotification Decimal @map("price_at_notification") @db.Decimal(12, 2)
  /// Loja onde o preço alvo foi atingido (melhor oferta no momento).
  storeId             String? @map("store_id") @db.Uuid

  sentAt    DateTime? @map("sent_at")
  error     String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceAlert PriceAlert @relation(fields: [priceAlertId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([priceAlertId])
  @@map("notifications")
}
