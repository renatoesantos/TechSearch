# Copy to .env before running docker compose.
POSTGRES_DB=techsearch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=techsearch-api
JWT_AUDIENCE=techsearch-web
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
FRONTEND_PORT=8080

# Optional SMTP. Without SMTP_HOST, email uses the development JSON transport.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=TechSearch <no-reply@techsearch.app>

# Scraper defaults
SCRAPER_ENABLED=true
SCRAPER_CRON=0 0,12 * * *
SCRAPER_HEADLESS=true
